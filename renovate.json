{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Toronto",
  "argocd": {
    "managerFilePatterns": ["/^clusters/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(platform|apps)/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version de Talos : la PR sert de rappel pour talosctl upgrade",
      "managerFilePatterns": ["/^talos/talos\\.env$/"],
      "matchStrings": ["TALOS_VERSION=(?<currentValue>v[^\\s]+)"],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Correctifs fusionnés automatiquement",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "cloudflared publie une version par mois",
      "matchPackageNames": ["cloudflare/cloudflared"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "Talos s'applique à la main avec talosctl : jamais de fusion automatique",
      "matchPackageNames": ["siderolabs/talos"],
      "automerge": false
    },
    {
      "description": "L'image du site est gérée par la CI",
      "matchPackageNames": ["ghcr.io/muskeg/muskeg-site"],
      "enabled": false
    }
  ]
}
